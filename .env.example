# Copy this file to .env and fill it in:   cp .env.example .env
# Never put .env on GitHub (it's already in .gitignore).

# ---- Website ----
PORT=8080
# The public address guests use. On your Mac: http://localhost:8080
# On the internet it must start with https://
BASE_URL=http://localhost:8080
# Set to 1 only if the site runs behind a proxy or host that forwards
# visitors' addresses in X-Forwarded-For (Caddy, nginx, Render, Fly.io...).
# Used to slow down people who try too many passwords or bookings.
TRUST_PROXY=
DATA_FILE=data/emeal.json
# Guests' names, emails and phone numbers are removed from bookings this many
# days after the visit (amounts stay for the reports). 0 = never remove.
DATA_RETENTION_DAYS=365

# ---- Restaurant (shown to guests and in emails) ----
RESTAURANT_NAME=E-Meal Kitchen
RESTAURANT_PHONE=
RESTAURANT_EMAIL=
# Printed on receipts (like the old till): street address, and the business
# ID (FO-nummer / Y-tunnus), e.g. 1234567-8. The manager can also set the
# business ID in the app (Staff → Business ID on receipts), which wins.
RESTAURANT_ADDRESS=
BUSINESS_ID=

# ---- Manager ----
ADMIN_USER=admin
# Leave empty on your Mac (demo login is admin/admin). On the internet it is REQUIRED:
# at least 12 characters, different from the other password.
# Make one with:  openssl rand -base64 18
ADMIN_PASSWORD=
# ---- Optional second manager login (was the "head manager") ----
# Same rights as the manager. Leave OWNER_PASSWORD empty to switch it off.
# If you set it on the internet: at least 12 characters.
OWNER_USER=owner
OWNER_PASSWORD=

# Gets an email for every confirmed booking
MANAGER_EMAIL=
# Gets the end-of-day summary, 30 minutes after closing (empty: MANAGER_EMAIL)
REPORT_EMAIL=
# The restaurant's "Ask for reviews" link from its Google Business Profile,
# e.g. https://g.page/r/XXXXXXXX/review. After giving feedback, every guest
# is offered this link to also review the restaurant on Google.
GOOGLE_REVIEW_URL=
# For SMS notifications (phase 2, not sent yet)
MANAGER_PHONE=
# Any long random text. Keeps staff logged in when the server restarts.
# Make one with:  openssl rand -hex 32
SESSION_SECRET=
# Any long random text (at least 24 characters, or the link is switched off).
# Makes a private calendar link for the manager's phone.
# Make one with:  openssl rand -hex 16
CALENDAR_TOKEN=

# ---- Stripe (leave empty = demo mode, no real payments) ----
# Demo mode only starts on localhost. To show a demo on a public address,
# set DEMO_MODE=1 (anyone there can "pay" without paying, so never for real).
DEMO_MODE=
# Stripe dashboard → Developers → API keys. Use sk_test_... until everything works.
STRIPE_SECRET_KEY=
# Stripe dashboard → Developers → Webhooks (or from `stripe listen`), starts with whsec_
STRIPE_WEBHOOK_SECRET=

# ---- Email (leave empty = emails are printed in the terminal) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# e.g. E-Meal Kitchen <bokning@emeal.ax>
MAIL_FROM=

# ---- Backups ----
# A copy of all data every night at 03:00, one file per day
# (emeal-2026-11-09.json), keeping the last BACKUP_KEEP days. Put the folder
# in Google Drive or iCloud so the copies are safe if this computer breaks,
# e.g. BACKUP_DIR=~/Google Drive/My Drive/emeal-backups
BACKUP_DIR=data/backups
BACKUP_KEEP=30

# ---- Switched off for now (the code is there; set to 1 to turn on) ----
# The call button on each table:
TABLE_BUTTONS=
# Guests order and pay with the table's QR code. Off: the only QR code is
# for feedback, and old table stickers lead to the feedback page.
TABLE_QR=
# Guests pay a deposit (10/20 €) to book a table online. Off: booking a
# table is free and confirmed at once. Takeaway still takes its 25 %.
TABLE_DEPOSIT=
